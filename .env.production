# Chaves do Supabase usadas no build de produção.
#
# Estas duas variáveis são públicas por natureza: elas são embutidas no
# JavaScript que roda no navegador de quem acessa o site, então versioná-las
# aqui não expõe nada que já não estivesse exposto. Quem protege os dados
# são as políticas de RLS do banco (veja supabase/migrations).
#
# Se preferirem gerenciá-las pelo painel da Vercel, é só cadastrar as mesmas
# variáveis lá e apagar este arquivo — o painel tem prioridade sobre ele.
NEXT_PUBLIC_SUPABASE_URL=https://pkisjcmskrvhhaestnqz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_FSu3Z3lJpO0MiPMK6nqx9A_9klReJ_C

# URL final do site, usada para resolver a imagem de compartilhamento
# (og.jpg) em endereço absoluto. Sem isso o Next cai na URL específica de
# cada deploy, que muda a cada publicação.
NEXT_PUBLIC_SITE_URL=https://casamento-deysiane-pedro.vercel.app
